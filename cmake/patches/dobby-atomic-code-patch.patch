+static kern_return_t remap_patch_page(addr_t patch_page, size_t page_size, void *address, uint8_t *buffer,
+                                      uint32_t buffer_size) {
+  auto self_task = mach_task_self();
+  mach_vm_address_t remap_dummy_page = 0;
+  kern_return_t kr = mach_vm_allocate(self_task, &remap_dummy_page, page_size, VM_FLAGS_ANYWHERE);
+  if (kr != KERN_SUCCESS)
+    return kr;
+
+  memcpy((void *)remap_dummy_page, (void *)patch_page, page_size);
+  memcpy((void *)(remap_dummy_page + ((addr_t)address - patch_page)), buffer, buffer_size);
+
+  kr = mach_vm_protect(self_task, remap_dummy_page, page_size, false, VM_PROT_READ | VM_PROT_EXECUTE);
+  if (kr == KERN_SUCCESS) {
+    mach_vm_address_t remap_dest_page = patch_page;
+    vm_prot_t prot, max_prot;
+    kr = mach_vm_remap(self_task, &remap_dest_page, page_size, 0, VM_FLAGS_OVERWRITE | VM_FLAGS_FIXED, self_task,
+                       remap_dummy_page, true, &prot, &max_prot, VM_INHERIT_COPY);
+  }
+
+  mach_vm_deallocate(self_task, remap_dummy_page, page_size);
+  return kr;
+}
