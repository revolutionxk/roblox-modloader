<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ScriptEditorWebview</RootNamespace>
    <AssemblyName>ScriptEditorWebview</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Platforms>x64</Platforms>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\code\dotnet\Runtime\src\RML.Core\RML.Core.csproj" Private="false" />
    <ProjectReference Include="..\..\..\..\code\dotnet\Roblox\src\Roblox\Roblox.csproj" Private="false" />
    <ProjectReference Include="..\..\..\..\code\dotnet\Runtime\src\RML.Interop\RML.Interop.csproj" Private="false" />
    <ProjectReference Include="..\..\..\..\code\dotnet\Runtime\src\RML.Logging\RML.Logging.csproj" Private="false" />
  </ItemGroup>
  <!--
    Runtime payloads live at the mod root, a sibling of the 'dotnet/' folder that holds this
    assembly (docs/writing-dotnet-mods.md: "copy the resulting assembly into .../mods/<your-mod>/dotnet/").
    ModContext.GetPath resolves against that mod root (ModContext.ResolveModRoot walks out of 'dotnet/'),
    so Link="..\" places each payload one level above the assembly's output directory instead of beside it.
  -->
  <ItemGroup>
    <Content Include="..\..\web\**\*" Link="..\web\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\luau\**\*.luau" Link="..\luau\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\bin\**\*" Link="..\tools\bin\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\cache\**\*" Link="..\tools\cache\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="FlattenWebView2Loader" AfterTargets="Build;Publish">
    <ItemGroup>
      <_WebView2Loader Include="$(OutDir)runtimes\win-x64\native\WebView2Loader.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_WebView2Loader)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutDir)runtimes\win-x64\native\WebView2Loader.dll')" />
  </Target>
  <Target Name="TrimUnusedWebView2Loaders" AfterTargets="Build">
    <ItemGroup>
      <_UnusedWebView2 Include="$(OutDir)Microsoft.Web.WebView2.Wpf.dll" />
      <_UnusedWebView2 Include="$(OutDir)Microsoft.Web.WebView2.Wpf.xml" />
      <_UnusedWebView2 Include="$(OutDir)Microsoft.Web.WebView2.WinForms.dll" />
      <_UnusedWebView2 Include="$(OutDir)Microsoft.Web.WebView2.WinForms.xml" />
      <_UnusedWebView2 Include="$(OutDir)Microsoft.Web.WebView2.Core.xml" />
    </ItemGroup>
    <Delete Files="@(_UnusedWebView2)" />
  </Target>
</Project>
